views {

  // C1 — System Context
  view index {
    title "C1 — System Context"
    description "Open Data Agent in relation to its users and external services"

    include *

    style llmBackend {
      color secondary
      opacity 70%
    }
    style tavilyApi {
      color secondary
      opacity 70%
    }
    style datagouvMcp {
      color secondary
      opacity 70%
    }
  }

  // C2 — Containers
  view c2_containers of agentPlayground {
    title "C2 — Containers"
    description "Internal containers of Open Data Agent and their communication protocols"

    include *
    include user, a2aClient, llmBackend, tavilyApi, datagouvMcp

    style llmBackend {
      color secondary
      opacity 70%
    }
    style tavilyApi {
      color secondary
      opacity 70%
    }
    style datagouvMcp {
      color secondary
      opacity 70%
    }
    style user {
      color muted
    }
    style a2aClient {
      color muted
    }
  }

  // Audience: New Developers
  view onboarding_devs of agentPlayground {
    title "New Developer Onboarding"
    description "For new contributors. Start with 'task run' (port 8000) and 'task ui' (port 3000). The same ReAct agent core serves both AG-UI and A2A protocols. Tools: web_search (Tavily) + data.gouv.fr open data (MCP)."

    include *
    include user, a2aClient, llmBackend, tavilyApi, datagouvMcp

    style llmBackend {
      color secondary
      opacity 60%
    }
    style tavilyApi {
      color secondary
      opacity 60%
    }
    style datagouvMcp {
      color secondary
      opacity 60%
    }
    style user {
      color muted
    }
    style a2aClient {
      color muted
    }

    autoLayout TopBottom
  }

  // Audience: Devops
  view devops_runtime {
    title "Devops — Runtime and External Dependencies"
    description "For platform/devops teams. Process boundaries, ports, and required env vars: OPENAI_API_BASE_URL, OPENAI_API_KEY, TAVILY_API_KEY. data.gouv.fr MCP has no key — public endpoint."

    include *

    style llmBackend {
      color amber
      opacity 80%
    }
    style tavilyApi {
      color amber
      opacity 80%
    }
    style datagouvMcp {
      color amber
      opacity 80%
    }
    style agentPlayground {
      color primary
    }

    autoLayout LeftRight
  }

}
